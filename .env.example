# Copy this file to .env and fill in your own keys. Never commit .env.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional: free endpoints from build.nvidia.com
NVIDIA_API_KEY=
TAVILY_API_KEY=
# Optional: second web search provider, used when Tavily fails or finds nothing.
# Free monthly credit, no card: dashboard.exa.ai
EXA_API_KEY=
# Optional: Langfuse tracing of searches, LLM calls and answers (cloud.langfuse.com, free tier)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Optional: label traces by where they ran (laptop, kaggle, space); Langfuse default "default"
LANGFUSE_TRACING_ENVIRONMENT=
# Hugging Face token with write access (needed for the Dataset repo and the Space)
HF_TOKEN=
# Dataset repo that stores the index/database, e.g. your-username/examprep-data
HF_DATASET_REPO=
# Where local data is kept (default: ./data)
EXAMPREP_DATA_DIR=./data
